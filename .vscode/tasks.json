        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Activar todos los microservicios",
      "type": "shell",
      "command": "./src/run-all.sh",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Detener todos los microservicios",
      "type": "shell",
      "command": "./src/stop-all.sh",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Activar users_service",
      "type": "shell",
